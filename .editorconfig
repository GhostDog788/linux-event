root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_style = tab

[Makefile]
indent_style = tab

[Kbuild]
indent_style = tab

[*.{json,md,yml,yaml}]
indent_style = space
indent_size = 2

[*.{c,h}]
indent_style = tab
indent_size = 8

[*.ps1]
indent_style = space
indent_size = 4
