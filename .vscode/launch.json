{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "debugEndpoint",
      "type": "promptString",
      "description": "GDB remote endpoint (host:port). Only used by Native Debug — cppdbg reads it from the generated .gdb script.",
      "default": "127.0.0.1:1234"
    }
  ],
  "configurations": [
    {
      "name": "Kernel: cppdbg (full GDB MI)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.gdb/current-vmlinux",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "targetArchitecture": "x64",
      "preLaunchTask": "Kernel: Deploy + Prep GDB",
      "setupCommands": [
        {
          "description": "Source the GDB init script generated by scripts/04",
          "text": "source ${workspaceFolder}/.gdb/current-debug.gdb",
          "ignoreFailures": false
        }
      ],
      "launchCompleteCommand": "exec-continue",
      "externalConsole": false
    },
    {
      "name": "Kernel: Native Debug (faster, fewer features)",
      "type": "gdb",
      "request": "attach",
      "executable": "${workspaceFolder}/.gdb/current-vmlinux",
      "target": "${input:debugEndpoint}",
      "remote": true,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Kernel: Deploy + Prep GDB",
      "valuesFormatting": "parseText",
      "autorun": [
        "source ${workspaceFolder}/.gdb/current-debug-attached.gdb"
      ]
    },
    {
      "name": "User: demo (remote)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/code/example/demo",
      "cwd": "${workspaceFolder}/code/example",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "targetArchitecture": "x64",
      "preLaunchTask": "User: Deploy + gdbserver",
      "setupCommands": [
        {
          "description": "Connect to the gdbserver started on the target by scripts/05",
          "text": "source ${workspaceFolder}/.gdb/current-user.gdb",
          "ignoreFailures": false
        }
      ],
      "launchCompleteCommand": "exec-continue",
      "externalConsole": false
    }
  ]
}
